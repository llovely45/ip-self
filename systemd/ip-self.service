[Unit]
Description=ip-self IP allowlist API
Documentation=https://github.com/llovely45/ip-self
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/ip-self/config.json
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/usr/local/bin/ip-self serve --config /etc/ip-self/config.json
Restart=always
RestartSec=5s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
